{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolio",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "ignaciobavala@gmail.com" }
  ],
  "routes": [
    { "pattern": "ivavala.com", "custom_domain": true },
    { "pattern": "www.ivavala.com", "custom_domain": true }
  ]
}
