{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolio",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "ignaciobavala@gmail.com" }
  ],
  "d1_databases": [
    {
      "binding": "portafolio_db",
      "database_name": "portafolio-db",
      "database_id": "1cc790cb-70d3-4d56-9a67-a5035e8914a1"
    }
  ],
  "routes": [
    { "pattern": "ivavala.com", "custom_domain": true },
    { "pattern": "www.ivavala.com", "custom_domain": true }
  ]
}
